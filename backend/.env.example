# Copy this to .env and fill in real values. .env itself is gitignored.

# Secret used to sign login tokens. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates every existing login token.
JWT_SECRET_KEY=replace_with_a_generated_secret

# Add any existing API keys (Adzuna, etc.) below as needed.

# Set to "true" once deployed behind real HTTPS — makes the login cookie
# only ever sent over HTTPS. Leave as false/unset for local development
# (http://localhost), or login will silently fail to persist.
COOKIE_SECURE=false

# Google Sign-In. Get this from Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client ID (type: Web application). Add your real
# domain to "Authorized JavaScript origins" once deployed. This value is
# NOT secret — it's also used in the frontend build.
GOOGLE_CLIENT_ID=

# --- Only needed on the DEPLOYED backend, to receive scraped listings ---
# from a local machine (see sync_to_remote.py). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SYNC_API_KEY=

# --- Only needed on the machine that does the actual scraping (e.g. your
# laptop, NOT the deployed backend) — where to send synced listings.
# Set SYNC_API_KEY here too, matching the deployed backend's value.
SYNC_TARGET_URL=

# Google Gemini — powers resume analysis, job summaries and pasted-text
# extraction. Get a key at https://aistudio.google.com/apikey
# (free-tier keys may let Google use submitted text; use a paid key for real CVs).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
